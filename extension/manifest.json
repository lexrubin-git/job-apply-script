{
  "manifest_version": 3,
  "name": "Apply Assistant",
  "version": "1.0",
  "description": "Fills internship applications from the Apply Assistant app on your computer. Only acts on tabs the app opens; never runs on LinkedIn or Handshake.",
  "permissions": [
    "storage",
    "webNavigation",
    "scripting",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply Assistant",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "*://linkedin.com/*",
        "*://*.linkedin.com/*",
        "*://licdn.com/*",
        "*://*.licdn.com/*",
        "*://lnkd.in/*",
        "*://*.lnkd.in/*",
        "*://joinhandshake.com/*",
        "*://*.joinhandshake.com/*",
        "*://handshake.com/*",
        "*://*.handshake.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "inpage.js",
        "shared.js",
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/go*"
      ],
      "js": [
        "go.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1/go*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "version_name": "fe57f14df4dd"
}
